{
  "manifest_version": 2,
  "name": "実際のフォルダー表示",
  "version": "0.2.0",
  "description": "統合フォルダーなどで表示中のメールが実際にどのアカウント・フォルダーにあるかを表示します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "real-folder-display@example.com",
      "strict_min_version": "102.0"
    }
  },
  "permissions": ["messagesRead", "accountsRead", "messagesModify"],
  "icons": {
    "96": "icons/icon-96.png",
    "48": "icons/icon-48.png",
    "24": "icons/icon-24.png"
  },
  "background": {
    "scripts": ["background.js"]
  }
}
